# Optional. By default, start.sh uses the current OS user and local PostgreSQL.
# DATABASE_URL=postgresql://your_user:your_password@127.0.0.1:5432/opengradient_studio
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=opengradient_studio
HOST=127.0.0.1
PORT=4310
# If PORT is occupied, the app tries the next 19 ports automatically.
# STRICT_PORT=1 disables automatic port selection.
# DEV_PORT=5173 sets the preferred frontend port for npm run dev.
# AI can also be connected from the app's AI settings dialog.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Docker alternative: USE_DOCKER=1 ./start.sh
# APP_DB_PASSWORD=choose-a-local-password

# OpenGradient connections can also be saved in the Connections screen.
# OG_HUB_EMAIL=your-account-email
# OG_HUB_PASSWORD=your-account-password
# OG_PRIVATE_KEY=your-dedicated-wallet-private-key
# Network execution stays disabled until explicitly enabled.
# OG_ALLOW_PAYMENTS=0
